#!/usr/bin/env python3
"""Clang CUDA driver with separate, persistent host/device LLVM bitcode.

Ordinary C/C++ actions use installed WLLVM. CUDA object actions retain their
native output, attach only host bitcode to .llvm_bc, and index device bitcode
separately. Compatible with the Apollo development image's Python 3.6.
"""

import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import tempfile


# The Clang the CUDA toolchain was configured with, substituted by
# third_party/gpus/cuda_configure.bzl. Host-configuration actions do not
# receive --action_env, so CLANG_CUDA_COMPILER_PATH alone is not enough.
CONFIGURED_COMPILER = "%{clang_cuda_compiler_path}"


def expand_response_files(args, depth=0):
    if depth > 20:
        raise ValueError("recursive compiler response file")
    result = []
    for arg in args:
        if arg.startswith("@"):
            result.extend(expand_response_files(
                shlex.split(Path(arg[1:]).read_text()), depth + 1))
        else:
            result.append(arg)
    return result


def option_values(args, option):
    values = []
    for index, arg in enumerate(args):
        if arg == option and index + 1 < len(args):
            values.append(args[index + 1])
        elif arg.startswith(option + "="):
            values.append(arg[len(option) + 1:])
    return values


def run(command, env):
    subprocess.check_call(command, env=env)


def ir_arguments(args):
    """Keep source semantics; remove native output/dependency/packaging flags."""
    result = []
    paired = {"-o", "-MF", "-MT", "-MQ", "-MJ", "--cuda-gpu-arch",
              "--cuda-include-ptx", "--no-cuda-include-ptx", "-Xcuda-fatbinary",
              "-Xcuda-ptxas"}
    single = {"-c", "-S", "-emit-llvm", "-MD", "-MMD", "-MP", "-MG",
              "--cuda-host-only", "--cuda-device-only",
              "--cuda-compile-host-device", "-save-temps"}
    index = 0
    while index < len(args):
        arg = args[index]
        if arg in paired:
            index += 2
            continue
        if (arg in single or
                any(arg.startswith(flag + "=") for flag in paired) or
                any(arg.startswith(flag) and arg != flag
                    for flag in ("-MF", "-MT", "-MQ", "-MJ")) or
                arg.startswith(("-save-temps=", "-flto", "-fwhole-program-vtables"))):
            index += 1
            continue
        result.append(arg)
        index += 1
    return result


def attach_host_bitcode(host, output, store, env):
    # Match WLLVM's path hash so extract-bc can also resolve through BC_STORE.
    digest = hashlib.sha256(str(host).encode("utf-8")).hexdigest()
    shutil.copyfile(str(host), str(store / digest))
    with tempfile.NamedTemporaryFile(mode="w", prefix="llvm-bc-path-") as record:
        record.write(str(host) + "\n")
        record.flush()
        run([env.get("LLVM_OBJCOPY", "objcopy"), "--add-section",
             ".llvm_bc=" + record.name, str(output)], env)


def main(argv):
    args = expand_response_files(argv)
    env = os.environ.copy()
    compiler = CONFIGURED_COMPILER
    if compiler.startswith("%{"):  # not generated by cuda_configure.bzl
        compiler = env.get("CLANG_CUDA_COMPILER_PATH", "clang++")
    compiler = shutil.which(compiler)
    if not compiler or os.path.realpath(compiler) == os.path.realpath(__file__):
        raise ValueError("CLANG_CUDA_COMPILER_PATH must identify a real Clang compiler")
    env["LLVM_COMPILER"] = "clang"
    env["LLVM_COMPILER_PATH"] = os.path.dirname(compiler)
    env["LLVM_CXX_NAME"] = os.path.basename(compiler)
    env["LLVM_CC_NAME"] = os.path.basename(compiler)
    store = Path(env.get("WLLVM_BC_STORE", "/apollo/wllvm_bc")).absolute()
    env["WLLVM_BC_STORE"] = str(store)

    languages = option_values(args, "-x")
    cuda = "cuda" in languages or "-xcuda" in args or any(
        arg.endswith(".cu") for arg in args)
    query = any(arg in args for arg in ("--version", "-E", "-M", "-MM", "-###"))
    if query or env.get("WLLVM_CONFIGURE_ONLY"):
        return subprocess.call([compiler] + args, env=env)
    store.mkdir(parents=True, exist_ok=True)
    if not cuda:
        c_only = "c" in languages or "-xc" in args or any(
            arg.endswith(".c") for arg in args)
        wrapper = "wllvm" if c_only else "wllvm++"
        executable = shutil.which(wrapper) or str(Path.home() / ".local/bin" / wrapper)
        env.setdefault("LLVM_BITCODE_GENERATION_FLAGS", "-flto -fwhole-program-vtables")
        if c_only:
            # The configured CUDA driver is commonly clang++; preserve C parsing
            # for C actions rather than accidentally compiling their sources as C++.
            args = ["--driver-mode=gcc"] + args
        return subprocess.call([executable] + args, env=env)

    if "-c" not in args or any(flag in args for flag in ("-S", "-emit-llvm")):
        raise ValueError("CUDA IR capture requires a -c object compilation action")
    if any(flag in args for flag in ("--cuda-host-only", "--cuda-device-only")):
        raise ValueError("CUDA IR capture expects a combined host/device object action")
    sources = [arg for arg in args if re.search(r"\.(cu|cc|cpp|cxx|c|C)$", arg)]
    if len(sources) != 1:
        raise ValueError("CUDA IR capture requires exactly one source per action")
    outputs = option_values(args, "-o")
    output = Path(outputs[-1] if outputs else Path(sources[0]).stem + ".o").absolute()
    arches = list(dict.fromkeys(option_values(args, "--cuda-gpu-arch")))
    if not arches or any(not re.match(r"^sm_[0-9]+[a-z]?$", arch) for arch in arches):
        raise ValueError("CUDA IR capture requires explicit --cuda-gpu-arch=sm_XX")

    # A unique directory prevents concurrent actions/configurations overwriting IR.
    cuda_store = store / "cuda"
    cuda_store.mkdir(exist_ok=True)
    destination = Path(tempfile.mkdtemp(prefix=Path(sources[0]).stem + "-",
                                        dir=str(cuda_store)))
    manifest = {"schema_version": 1, "status": "building",
                "source": str(Path(sources[0]).absolute()), "object": str(output),
                "cwd": os.getcwd(), "compiler": compiler, "arguments": args,
                "architectures": arches, "commands": [], "device_bitcode": {}}
    manifest_path = destination / "manifest.json"

    def execute(command):
        manifest["commands"].append(command)
        run(command, env)

    try:
        execute([compiler] + args)
        # Keep the bitcode the driver itself produces for the object. Unlike a
        # separate --cuda-host-only compile, its host module embeds the fatbinary
        # and the kernel registration (__cuda_module_ctor, __cuda_register_globals).
        temps = destination / "temps"
        temps.mkdir()
        execute([compiler] + ir_arguments(args) +
                ["--cuda-gpu-arch=" + arch for arch in arches] +
                ["-c", "-save-temps=obj", "-o", str(temps / "capture.o")])
        stem = Path(sources[0]).stem
        hosts = list(temps.glob(stem + "-host-*.bc"))
        if len(hosts) != 1:
            raise ValueError("expected one host bitcode from -save-temps, found {}".format(
                [h.name for h in hosts]))
        host = destination / "host.bc"
        shutil.move(str(hosts[0]), str(host))
        manifest["host_bitcode"] = str(host)
        for arch in arches:
            device = destination / ("device." + arch + ".bc")
            shutil.move(str(temps / "{}-cuda-nvptx64-nvidia-cuda-{}.bc".format(stem, arch)),
                        str(device))
            manifest["device_bitcode"][arch] = str(device)
        shutil.rmtree(str(temps))
        attach_host_bitcode(host, output, store, env)
        manifest["status"] = "complete"
        print("[cuda-ir] " + str(manifest_path), file=sys.stderr)
    except (subprocess.CalledProcessError, OSError, ValueError) as error:
        manifest["status"] = "failed"
        manifest["error"] = str(error)
        # Do not leave a seemingly valid object when mandatory IR capture failed.
        if output.exists():
            output.unlink()
        raise
    finally:
        manifest_path.write_text(json.dumps(manifest, indent=2) + "\n")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except (subprocess.CalledProcessError, OSError, ValueError) as error:
        print("cuda-ir: " + str(error), file=sys.stderr)
        sys.exit(1)
